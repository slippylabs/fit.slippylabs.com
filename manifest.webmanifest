{
  "name": "SlipFit",
  "short_name": "SlipFit",
  "description": "Workout tracker, plans, goals and fitness calculators.",
  "start_url": "/#/today",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d1117",
